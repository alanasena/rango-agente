# Copie este arquivo para backend/.env e preencha. O .env NUNCA vai para o GitHub.

# Chave grátis em https://aistudio.google.com/apikey
GEMINI_API_KEY=coloque_sua_chave_aqui

# Modelo principal e modelo reserva (usado quando a cota do principal acaba)
GEMINI_MODEL=gemini-flash-latest
GEMINI_MODEL_RESERVA=gemini-flash-lite-latest

# Quanto o modelo "pensa" antes de responder: low (mais rápido), medium ou high
GEMINI_PENSAMENTO=low
# Tempo máximo esperando o Gemini, em segundos
GEMINI_TIMEOUT_SEG=30

# Banco: SQLite local. Para PostgreSQL: postgresql://usuario:senha@host/banco
DATABASE_URL=sqlite:///./rango.db

# Endereço da tela (separe vários com vírgula, sem espaço)
FRONTEND_URL=http://localhost:5173

# Limite de mensagens por hora por pessoa (protege sua cota quando o site está público)
LIMITE_MENSAGENS_POR_HORA=30
